# Chuẩn hóa xuống dòng: file text lưu LF trong Git.
* text=auto

# ---------------------------------------------------------------
# Text: KHÔNG BAO GIỜ đưa vào LFS (cần diff và merge).
# Script, scene, prefab, asset YAML, .meta, JSON, tài liệu text.
# ---------------------------------------------------------------
*.cs              text diff=csharp
*.asmdef          text
*.asmref          text
*.meta            text
*.unity           text
*.prefab          text
*.asset           text
*.mat             text
*.anim            text
*.controller      text
*.overrideController text
*.physicMaterial  text
*.physicsMaterial2D text
*.spriteatlas     text
*.spriteatlasv2   text
*.inputactions    text
*.shadergraph     text
*.shadersubgraph  text
*.shader          text
*.hlsl            text
*.uss             text
*.uxml            text
*.json            text
*.jsonl           text
*.txt             text
*.md              text
*.yaml            text
*.yml             text

# ---------------------------------------------------------------
# Nhị phân nhỏ: lưu thường trong Git, không diff/merge text.
# Theo TDD mục 13: PNG prototype và font chưa cần LFS.
# ---------------------------------------------------------------
*.png    binary
*.jpg    binary
*.jpeg   binary
*.ttf    binary
*.otf    binary
*.ogg    binary
*.mp3    binary
*.dll    binary
*.so     binary
*.aar    binary
*.jar    binary
*.docx   binary
*.xlsx   binary
*.pdf    binary

# ---------------------------------------------------------------
# Git LFS: nguồn nhị phân lớn (TDD mục 13 — PSD, audio nguồn, FBX).
# ---------------------------------------------------------------
*.psd      filter=lfs diff=lfs merge=lfs -text
*.psb      filter=lfs diff=lfs merge=lfs -text
*.aseprite filter=lfs diff=lfs merge=lfs -text
*.ase      filter=lfs diff=lfs merge=lfs -text
*.kra      filter=lfs diff=lfs merge=lfs -text
*.tif      filter=lfs diff=lfs merge=lfs -text
*.tiff     filter=lfs diff=lfs merge=lfs -text
*.exr      filter=lfs diff=lfs merge=lfs -text
*.hdr      filter=lfs diff=lfs merge=lfs -text
*.fbx      filter=lfs diff=lfs merge=lfs -text
*.blend    filter=lfs diff=lfs merge=lfs -text
*.wav      filter=lfs diff=lfs merge=lfs -text
*.aif      filter=lfs diff=lfs merge=lfs -text
*.aiff     filter=lfs diff=lfs merge=lfs -text
*.flac     filter=lfs diff=lfs merge=lfs -text
*.mp4      filter=lfs diff=lfs merge=lfs -text
*.mov      filter=lfs diff=lfs merge=lfs -text

# Ảnh AI gốc/chưa chuẩn hóa trong ArtSource/ (Art Guide mục 16) có thể lớn.
ArtSource/**/*.png  filter=lfs diff=lfs merge=lfs -text
ArtSource/**/*.jpg  filter=lfs diff=lfs merge=lfs -text
ArtSource/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
ArtSource/**/*.webp filter=lfs diff=lfs merge=lfs -text
